# Copy this file to .env and change the values if you want.
# .env is ignored by git, so real passwords never get committed.
POSTGRES_DB=ItHelpDesk
POSTGRES_USER=user
POSTGRES_PASSWORD=pwd
# Port on your computer. 5434 avoids clashing with a Postgres installed locally.
POSTGRES_PORT=5434

PGADMIN_EMAIL=admin@hackathon2026.com
PGADMIN_PASSWORD=adminpassword

# TiqVision AI triage (backend only, never put this in the frontend).
# Leave empty to run without AI: text triage falls back to built-in rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
